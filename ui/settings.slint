import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { Card, SettingRow, LinkRow, Divider, SectionTitle, Segmented } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        padding-bottom: 6px;
        spacing: 8px;
        Text {
            text: "Настройки";
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
            x: 18px;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 12px;
                spacing: 8px;
                SectionTitle { text: "ОСНОВНЫЕ"; x: 4px; }
                Card {
                    VerticalLayout {
                        SettingRow {
                            title: "Запускать вместе с Windows";
                            checked: App.autostart;
                            toggled(v) => { App.set-flag("autostart", v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Подключаться автоматически";
                            subtitle: "Включать VPN при запуске компьютера";
                            checked: App.connect-on-start;
                            toggled(v) => { App.set-flag("connect_on_start", v); }
                        }
                    }
                }
                SectionTitle { text: "СЕРВЕРЫ"; x: 4px; }
                Card {
                    VerticalLayout {
                        SettingRow {
                            title: "Cloudflare WARP";
                            subtitle: App.warp && App.warp-note != "" ? "Бесплатный узел Cloudflare · " + App.warp-note : "Бесплатный узел Cloudflare (AmneziaWG / MASQUE)";
                            checked: App.warp;
                            toggled(v) => { App.set-flag("warp", v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Поиск через входное звено";
                            subtitle: "Серверы, блокируемые ТСПУ напрямую, проверять через рабочий узел (2-hop)";
                            checked: App.relay-scan;
                            toggled(v) => { App.set-flag("relay_scan", v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Защита HTTP на порту 80";
                            subtitle: "Не передавать нешифрованный HTTP через чужие публичные серверы (только свой сервер / WARP или блокировка)";
                            checked: App.https-only-free;
                            toggled(v) => { App.set-flag("https_only_free", v); }
                        }
                        if App.https-only-free: Divider { }
                        if App.https-only-free: SettingRow {
                            title: "Разрешить прямой выход HTTP (порт 80)";
                            subtitle: "Если нет своего сервера и WARP, пускать порт 80 напрямую мимо VPN (раскрывает ваш IP на старых HTTP-сайтах)";
                            checked: App.http-allow-direct;
                            toggled(v) => { App.set-flag("http_allow_direct", v); }
                        }
                        Divider { }
                        LinkRow {
                            title: "Источники серверов";
                            subtitle: "Откуда брать бесплатные серверы";
                            icon: "list";
                            clicked => { App.open-dialog("sources"); }
                        }
                        Divider { }
                        LinkRow {
                            title: "Подписки";
                            icon: "link";
                            value: App.subs.length > 0 ? App.subs.length : "";
                            clicked => { App.open-dialog("subs"); }
                        }
                    }
                }
                SectionTitle { text: "СЕТЬ"; x: 4px; }
                Card {
                    VerticalLayout {
                        LinkRow {
                            title: "Проверка сети";
                            subtitle: App.net-summary != "" ? App.net-summary : "Что блокирует ваша сеть (TCP/UDP/Cloudflare/DNS/16 КБ)";
                            icon: "radar";
                            clicked => { App.open-dialog("net-test"); }
                        }
                        Divider { }
                        SettingRow {
                            title: "Защита от утечек";
                            subtitle: "Строгая маршрутизация (strict-route) и защита от утечек DNS/WebRTC";
                            checked: App.strict-route;
                            toggled(v) => { App.set-flag("strict_route", v); }
                        }
                        Divider { }
                        SettingRow {
                            title: "IPv6";
                            subtitle: "Передавать IPv6-трафик через VPN";
                            checked: App.ipv6;
                            toggled(v) => { App.set-flag("ipv6", v); }
                        }
                        Divider { }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text { text: "Сетевой стек"; color: Theme.text; font-size: Theme.font; }
                            Segmented {
                                items: ["gVisor", "Mixed", "System"];
                                current: App.stack;
                                changed(i) => { App.set-stack(i); }
                            }
                            Text {
                                text: "gVisor — максимальная совместимость без запросов брандмауэра. Mixed — системный TCP + gVisor для UDP (баланс скорости и надёжности). System — максимальная скорость TCP, может запросить разрешение брандмауэра Windows.";
                                color: Theme.dim;
                                font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                SectionTitle { text: "ОБНОВЛЕНИЯ"; x: 4px; }
                Card {
                    VerticalLayout {
                        SettingRow {
                            title: "Проверять обновления";
                            subtitle: "Раз в 12 часов с обязательной проверкой SHA-256 и заголовка PE";
                            checked: App.auto-update;
                            toggled(v) => { App.set-flag("auto_update", v); }
                        }
                        Divider { }
                        LinkRow {
                            title: App.upd-program != "" ? "Доступна Лазейка " + App.upd-program : "Лазейка " + App.version;
                            subtitle: App.upd-busy ? "Загрузка…" : App.upd-program != "" ? "Нажмите, чтобы скачать и установить" : (App.upd-text != "" ? App.upd-text : "Нажмите, чтобы проверить обновления");
                            icon: "refresh";
                            clicked => {
                                if (App.upd-program != "") { App.install-program-update(); } else { App.check-updates(); }
                            }
                        }
                        if App.upd-mihomo != "": Divider { }
                        if App.upd-mihomo != "": LinkRow {
                            title: "Доступен mihomo " + App.upd-mihomo;
                            subtitle: "Нажмите, чтобы установить (применится при подключении)";
                            icon: "refresh";
                            clicked => { App.install-mihomo-update(); }
                        }
                    }
                }
                SectionTitle { text: "О ПРОГРАММЕ"; x: 4px; }
                Card {
                    VerticalLayout {
                        LinkRow {
                            title: "Журнал";
                            icon: "file";
                            clicked => { App.open-dialog("log"); }
                        }
                        Divider { }
                        LinkRow {
                            title: "Лазейка " + App.version;
                            subtitle: (App.core-version != "" ? "Ядро mihomo " + App.core-version + " · " : "") + "GPL-3.0 · без телеметрии";
                            icon: "shield";
                            clicked => { App.open-dialog("about"); }
                        }
                        if App.can-uninstall: Divider { }
                        if App.can-uninstall: LinkRow {
                            title: "Удалить Лазейку";
                            title-color: Theme.err;
                            icon: "trash";
                            clicked => { App.open-dialog("uninstall"); }
                        }
                    }
                }
            }
        }
    }
}
