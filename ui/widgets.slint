import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
}

export component Clickable inherits Rectangle {
    callback clicked;
    in property <bool> enabled: true;
    in property <color> base: Theme.card;
    out property <bool> hover: ta.has-hover;
    out property <bool> down: ta.pressed;
    background: !enabled ? base : ta.pressed ? Theme.card-press : ta.has-hover ? Theme.card-hover : base;
    border-radius: Theme.radius;
    animate background { duration: 120ms; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    @children
}

export component IconButton inherits Rectangle {
    callback clicked;
    in property <string> icon;
    in property <color> tint: Theme.dim;
    in property <length> size: 18px;
    in property <string> tooltip;
    in property <bool> enabled: true;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: ta.pressed ? Theme.card-press : ta.has-hover ? Theme.card-hover : transparent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    Icon {
        name: root.icon;
        size: root.size;
        color: ta.has-hover && root.enabled ? Theme.text : root.tint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// kind: 0 primary (accent), 1 secondary (card), 2 ghost (text only), 3 danger
export component Btn inherits Rectangle {
    callback clicked;
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    min-height: 38px;
    min-width: lay.preferred-width;
    border-radius: 11px;
    opacity: enabled ? 1 : 0.45;
    property <color> base: kind == 0 ? Theme.accent : kind == 1 ? Theme.card-hover : kind == 3 ? Theme.err.with-alpha(0.14) : transparent;
    property <color> fg: kind == 0 ? Theme.on-accent : kind == 3 ? Theme.err : kind == 2 ? Theme.accent : Theme.text;
    background: ta.pressed && enabled ? base.darker(0.15) : ta.has-hover && enabled ? (kind == 0 ? Theme.accent.brighter(0.08) : kind == 2 ? Theme.card-hover : base.brighter(0.25)) : base;
    animate background { duration: 120ms; }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.busy ? "refresh" : root.icon;
            size: 16px;
            color: root.fg;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Theme.accent : Theme.line;
    opacity: enabled ? 1 : 0.45;
    animate background { duration: 150ms; }
    knob := Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 9px;
        background: root.checked ? Theme.on-accent : Theme.dim;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Segmented control with up to 3 items.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback changed(int);
    height: 36px;
    border-radius: 11px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    property <length> seg-w: (self.width - 6px) / max(1, items.length);
    Rectangle {
        x: 3px + root.current * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: root.height - 6px;
        border-radius: 8px;
        background: Theme.card-hover;
        animate x { duration: 160ms; easing: ease-out; }
    }
    for it[i] in root.items: Rectangle {
        x: 3px + i * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: root.height - 6px;
        Text {
            text: it;
            font-size: 13px;
            font-weight: i == root.current ? 600 : 400;
            color: i == root.current ? Theme.text : Theme.dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.current != i) {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Compact button that opens a picker: icon, value text, chevron.
export component Pill inherits Rectangle {
    callback clicked;
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    height: 34px;
    border-radius: 10px;
    background: ta.pressed ? Theme.card-press : ta.has-hover ? Theme.card-hover : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.5) : Theme.line;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 7px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 15px;
            color: root.active ? Theme.accent : Theme.dim;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 12.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            name: "chevron-down";
            size: 14px;
            color: Theme.faint;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One choice in a picker dialog.
export component OptionRow inherits Rectangle {
    callback clicked;
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <bool> checked;
    min-height: subtitle == "" ? 42px : 54px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.card-hover : Theme.card;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: 13.5px; overflow: elide; }
            if root.subtitle != "": Text { text: root.subtitle; color: Theme.dim; font-size: 11.5px; wrap: word-wrap; }
        }
        if root.value != "": Text {
            text: root.value;
            color: Theme.dim;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        Rectangle {
            width: 20px;
            if root.checked: Icon {
                name: "check";
                size: 18px;
                color: Theme.accent;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Badge inherits Rectangle {
    in property <string> cc;
    in property <bool> warp;
    in property <bool> auto;
    in property <bool> dead;
    width: 38px;
    height: 28px;
    border-radius: 8px;
    background: auto ? Theme.accent.with-alpha(0.16) : warp ? #f6821f.with-alpha(0.16) : Theme.card-hover;
    border-width: 1px;
    border-color: auto ? Theme.accent.with-alpha(0.35) : warp ? #f6821f.with-alpha(0.4) : Theme.line;
    opacity: dead ? 0.5 : 1;
    if root.auto || root.warp: Icon {
        name: root.auto ? "zap" : "cloud";
        size: 16px;
        color: root.auto ? Theme.accent : #f6821f;
    }
    if !root.auto && !root.warp: Text {
        text: root.cc == "" ? "··" : root.cc;
        font-size: 12px;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.dim;
    height: 16px;
    width: t.preferred-width + 8px;
    border-radius: 4px;
    background: tint.with-alpha(0.14);
    t := Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <string> icon;
    callback accepted(string);
    callback edited(string);
    height: 40px;
    border-radius: 11px;
    background: Theme.panel;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent.with-alpha(0.7) : Theme.line;
    animate border-color { duration: 120ms; }
    public function focus-input() { ti.focus(); }
    public function clear() { ti.text = ""; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 16px;
            color: Theme.faint;
        }
        Rectangle {
            // Clipboard shortcuts on non-Latin layouts: with a Russian/Ukrainian layout
            // Ctrl+V arrives as "м", Ctrl+C as "с" and so on, which the built-in handling
            // does not recognise. Also Shift+Insert / Ctrl+Insert / Shift+Delete.
            fs := FocusScope {
                width: 100%;
                height: 100%;
                capture-key-pressed(e) => {
                    if (e.modifiers.control && !e.modifiers.alt) {
                        if (e.text == "м" || e.text == "М") { ti.paste(); return accept; }
                        if (e.text == "с" || e.text == "С") { ti.copy(); return accept; }
                        if (e.text == "ч" || e.text == "Ч") { ti.cut(); return accept; }
                        if (e.text == "ф" || e.text == "Ф") { ti.select-all(); return accept; }
                        if (e.text == "\u{f727}") { ti.copy(); return accept; }
                    }
                    if (e.modifiers.shift && !e.modifiers.control && e.text == "\u{f727}") { ti.paste(); return accept; }
                    if (e.modifiers.shift && !e.modifiers.control && e.text == "\u{7f}") { ti.cut(); return accept; }
                    reject
                }
                ti := TextInput {
                    width: 100%;
                    height: 100%;
                    color: Theme.text;
                    font-size: Theme.font;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.text;
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                }
            }
            if ti.text == "": Text {
                x: 0;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.faint;
                font-size: Theme.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component SectionTitle inherits Text {
    color: Theme.faint;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: subtitle == "" ? 48px : 62px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.dim;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                enabled: root.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

export component LinkRow inherits Clickable {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <string> value;
    in property <color> title-color: Theme.text;
    base: transparent;
    border-radius: 0;
    min-height: subtitle == "" ? 48px : 62px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 18px;
            color: Theme.dim;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: Theme.font;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.dim;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
        if root.value != "": Text {
            text: root.value;
            color: Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            name: "chevron-right";
            size: 16px;
            color: Theme.faint;
        }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <bool> indeterminate;
    height: 4px;
    border-radius: 2px;
    background: Theme.line;
    clip: true;
    property <bool> phase;
    Timer {
        interval: 700ms;
        running: root.indeterminate;
        triggered => { root.phase = !root.phase; }
    }
    Rectangle {
        x: root.indeterminate ? (root.phase ? root.width * 0.6 : 0) : 0;
        width: root.indeterminate ? root.width * 0.4 : root.width * clamp(root.value, 0, 1);
        height: root.height;
        border-radius: 2px;
        background: Theme.accent;
        animate x { duration: 700ms; easing: ease-in-out; }
        animate width { duration: 300ms; }
    }
}

// Modal frame shown over the window.
export component Modal inherits Rectangle {
    in property <string> title;
    callback close();
    in property <length> max-h: 560px;
    background: #000000a0;
    TouchArea {
        clicked => { root.close(); }
    }
    panel := Rectangle {
        x: 14px;
        width: root.width - 28px;
        height: min(root.height - 40px, max(lay.preferred-height, 120px), root.max-h);
        y: (root.height - self.height) / 2;
        background: Theme.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        TouchArea { }
        lay := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    icon: "x";
                    clicked => { root.close(); }
                }
            }
            @children
        }
    }
}
