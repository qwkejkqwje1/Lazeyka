export component TargetChainDialog inherits Modal {
    property <bool> edit: App.target-for != "";
    title: "Цепочка";
    max-h: 660px;
    close => { App.dialog = ""; }
    VerticalLayout {
        spacing: 8px;
        OptionRow { title: "VPN → WARP"; subtitle: "Сначала VPN, затем WARP"; clicked => { App.chain-template(0, App.target-for); } }
        if App.warp-good: OptionRow { title: "WARP → VPN"; subtitle: "Сначала WARP, затем подходящий сервер VPN (не WireGuard)"; clicked => { App.chain-template(1, App.target-for); } }
        Rectangle {
            height: min(App.target-chains.length * 52px, 210px);
            if App.target-chains.length > 0: ListView {
                for c in App.target-chains: Rectangle {
                    height: 52px;
                    TargetRow {
                        y: 2px;
                        item: c;
                        checked: root.edit && App.picker-target == c.code;
                        clicked => { App.pick-target(c.code); }
                    }
                }
            }
        }
        Text {
            text: "Трафик идёт через звенья по очереди и выходит в интернет через последнее. Страна выхода — страна последнего звена.";
            color: Theme.faint;
            font-size: 11.5px;
            wrap: word-wrap;
        }
        Btn { text: "Новая цепочка…"; kind: 1; clicked => { App.chain-new(); } }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: "Назад";
                icon: "chevron-left";
                kind: 2;
                min-height: 32px;
                clicked => { App.target-step = 0; }
            }
        }
    }
}

// A row of the chains manager and the lists dialog: name, info, two actions.
component ActionRow inherits Rectangle {
    in property <string> title;
    in property <string> info;
    in property <bool> dim: false;
    callback edit;
    callback remove;
    height: 52px;
    Rectangle {
        y: 2px;
        height: 48px;
        border-radius: 10px;
        background: Theme.card;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text { text: root.title; color: root.dim ? Theme.dim : Theme.text; font-size: 13px; overflow: elide; }
                Text { text: root.info; color: Theme.dim; font-size: 11px; overflow: elide; }
            }
            Btn {
                text: "Изменить";
                kind: 2;
                min-height: 30px;
                clicked => { root.edit(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: "trash";
                size: 16px;
                clicked => { root.remove(); }
            }
        }
    }
}

export component ChainsDialog inherits Modal {
    title: "Цепочки";
    max-h: 660px;
    close => { App.dialog = ""; }
    VerticalLayout {
        spacing: 8px;
        Text {
            text: "Цепочка — до трёх звеньев подряд: сервер, страна или VPN. Её можно назначить маршруту или всему трафику по умолчанию.";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        if App.target-chains.length == 0: Text {
            text: "Цепочек пока нет.";
            color: Theme.faint;
            font-size: 12.5px;
        }
        Rectangle {
            height: min(App.target-chains.length * 52px, 320px);
            visible: App.target-chains.length > 0;
            ListView {
                for c in App.target-chains: ActionRow {
                    title: c.title;
                    info: c.subtitle;
                    dim: !c.ok;
                    edit => { App.chain-edit(c.code); }
                    remove => { App.chain-delete(c.code); }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: "Новая цепочка";
                icon: "plus";
                kind: 0;
                min-height: 34px;
                clicked => { App.chain-new(); }
            }
        }
    }
}

export component ChainEditDialog inherits Modal {
    title: "Цепочка";
    max-h: 660px;
    close => { App.dialog = "chains"; }
    VerticalLayout {
        spacing: 8px;
        name := Field {
            text <=> App.chain-name;
            placeholder: "Название, например: Через Штаты";
        }
        if App.chain-hops.length == 0: Text {
            text: "Добавьте от одного до трёх звеньев. Каждое следующее звено подключается через предыдущее.";
            color: Theme.faint;
            font-size: 12px;
            wrap: word-wrap;
        }
        for h[i] in App.chain-hops: Rectangle {
            height: 48px;
            border-radius: 10px;
            background: Theme.card;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text { text: h.title; color: Theme.text; font-size: 13px; overflow: elide; }
                    Text { text: h.subtitle; color: Theme.dim; font-size: 11px; }
                }
                Btn {
                    text: "Изменить";
                    kind: 2;
                    min-height: 30px;
                    clicked => { App.chain-hop-pick(i); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: "trash";
                    size: 16px;
                    clicked => { App.chain-hop-remove(i); }
                }
            }
        }
        if App.chain-hops.length < 3: HorizontalLayout {
            alignment: start;
            Btn {
                text: "Добавить звено";
                icon: "plus";
                kind: 1;
                min-height: 32px;
                clicked => { App.chain-hop-add(); }
            }
        }
        Text {
            text: "Страна выхода — страна последнего звена. Если цепочка не соберётся, её трафик пойдёт через VPN.";
            color: Theme.faint;
            font-size: 11.5px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn {
                text: "Отмена";
                kind: 1;
                clicked => { App.dialog = "chains"; }
            }
            Btn {
                text: "Сохранить";
                kind: 0;
                enabled: App.chain-hops.length > 0;
                clicked => { App.chain-save(); }
            }
        }
    }
}

export component HopKindsDialog inherits Modal {
