export component RouteDeleteDialog inherits Modal {
    title: "Удалить маршрут?";
    close => { App.dialog = ""; }
    Text {
        text: "«" + App.route.name + "» (" + App.route.summary + ") будет удалён. Его сайты и программы пойдут как остальной трафик.";
