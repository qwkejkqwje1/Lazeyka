export component ListsDialog inherits Modal {
    title: "Списки сайтов и программ";
    max-h: 700px;
    close => { App.dialog = ""; }
    VerticalLayout {
        spacing: 8px;
        search := Field {
            placeholder: "Поиск по всем спискам и маршрутам";
            icon: "search";
            text <=> App.list-search;
            edited(t) => { App.search-lists(t); }
        }
        if App.list-search != "": Rectangle {
            height: min(max(App.search-hits.length, 1) * 40px, 300px);
            if App.search-hits.length == 0: Text {
                text: "Ничего не нашлось.";
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if App.search-hits.length > 0: ListView {
                for h in App.search-hits: Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: h.text; color: Theme.text; font-size: 12.5px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: h.where; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                    }
                }
            }
        }
        if App.list-search == "": VerticalLayout {
            spacing: 8px;
            Text {
                text: "Список хранится один раз и подключается к маршрутам: изменили список — обновились все маршруты с ним.";
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if App.lists.length == 0: Text {
                text: "Списков пока нет — создайте первый, например «Банки» или «Работа».";
                color: Theme.faint;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            Rectangle {
                height: min(App.lists.length * 52px, 320px);
                visible: App.lists.length > 0;
                ListView {
                    for l in App.lists: ActionRow {
                        title: l.name;
                        info: l.info;
                        edit => { App.list-edit(l.id); }
                        remove => {
                            App.edit-id = l.id;
                            App.edit-name = l.name;
                            App.dialog = "list-delete";
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                Btn {
                    text: "Новый список";
                    icon: "plus";
                    kind: 0;
                    min-height: 34px;
                    clicked => { App.list-new(); }
                }
            }
        }
    }
}

export component ListEditDialog inherits Modal {
    property <[string]> list: App.list-tab == 0 ? App.sites : App.apps;
    title: App.list-name;
    max-h: 720px;
    close => { App.dialog = "lists"; }
    VerticalLayout {
        spacing: 8px;
        Clickable {
            height: 56px;
            clicked => {
                App.target-for = "@list:" + App.list-id;
                App.target-step = 0;
                App.open-dialog("target");
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                RouteBadge {
                    y: (parent.height - self.height) / 2;
                    kind: App.list-kind;
                    cc: App.list-cc;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: "Куда отправить список"; color: Theme.dim; font-size: 11.5px; }
                    Text {
                        text: App.list-target-label == "" ? "Не подключён — выберите направление" : App.list-target-label;
                        color: Theme.text;
                        font-size: 13.5px;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
                Icon { y: (parent.height - self.height) / 2; name: "chevron-right"; size: 16px; color: Theme.faint; }
            }
        }
        Text {
            text: "Своё направление забирает сайты и программы списка, которые не взял ни один маршрут выше.";
            color: Theme.faint;
            font-size: 11.5px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn {
                text: "Переименовать";
                kind: 2;
                min-height: 30px;
                clicked => {
                    App.edit-id = App.list-id;
                    App.edit-name = App.list-name;
                    App.dialog = "list-name";
                }
            }
        }
        Segmented {
            items: ["Сайты · " + App.sites.length, "Программы · " + App.apps.length];
            current <=> App.list-tab;
        }
        HorizontalLayout {
            spacing: 8px;
            input := Field {
                placeholder: App.list-tab == 0 ? "example.com или 10.0.0.0/8" : "program.exe";
                icon: App.list-tab == 0 ? "globe" : "app";
                accepted(t) => {
                    if (t != "") {
                        App.list-add-entry(App.list-tab, t);
                        input.clear();
                    }
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                icon: "plus";
                tint: Theme.accent;
                clicked => {
                    if (input.text != "") {
                        App.list-add-entry(App.list-tab, input.text);
                        input.clear();
                    }
                }
            }
        }
        if root.list.length == 0: Text {
            text: App.list-tab == 0 ? "Добавьте сайты в этот список." : "Добавьте программы в этот список.";
            color: Theme.dim;
            font-size: 12.5px;
            wrap: word-wrap;
        }
        if root.list.length > 0: Rectangle {
            height: min(root.list.length * 44px, 300px);
            ListView {
                for v in root.list: Rectangle {
                    height: 44px;
                    Rectangle {
                        y: 2px;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.card;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 4px;
                            spacing: 10px;
                            Icon { y: (parent.height - self.height) / 2; name: App.list-tab == 0 ? "globe" : "app"; size: 16px; color: Theme.faint; }
                            Text { text: v; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "trash";
                                size: 16px;
                                clicked => { App.list-remove-entry(App.list-tab, v); }
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: "Изменения сразу применяются ко всем маршрутам, где подключён этот список.";
            color: Theme.faint;
            font-size: 11.5px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn {
                text: "Импорт";
                icon: "download";
                kind: 2;
                min-height: 32px;
                clicked => { App.list-import(App.list-tab); }
            }
            Btn {
                text: "Экспорт";
                icon: "upload";
                kind: 2;
                min-height: 32px;
                enabled: root.list.length > 0;
                clicked => { App.list-export(App.list-tab); }
            }
            Btn {
                text: "Готово";
                kind: 0;
                min-height: 32px;
                clicked => { App.dialog = "lists"; }
            }
        }
    }
}

export component ListNameDialog inherits Modal {
    title: "Название списка";
    close => { App.dialog = "list-edit"; }
    f := Field {
        text: App.edit-name;
        placeholder: "Например: Банки";
        accepted(t) => { App.list-rename(App.edit-id, t); }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Btn {
            text: "Отмена";
            kind: 1;
            clicked => { App.dialog = "list-edit"; }
        }
        Btn {
            text: "Сохранить";
            kind: 0;
            clicked => { App.list-rename(App.edit-id, f.text); }
        }
    }
}

export component ListDeleteDialog inherits Modal {
    title: "Удалить список?";
    close => { App.dialog = "lists"; }
    Text {
        text: "«" + App.edit-name + "» будет удалён и отключён от всех маршрутов. Сами маршруты останутся.";
        color: Theme.text;
        font-size: 12.5px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Btn {
            text: "Отмена";
            kind: 1;
            clicked => { App.dialog = "lists"; }
        }
        Btn {
            text: "Удалить";
            kind: 3;
            clicked => {
                App.list-delete(App.edit-id);
                App.dialog = "lists";
            }
        }
    }
}


export component PresetsDialog inherits Modal {
    title: "Каталог наборов";
    max-h: 680px;
    close => { App.dialog = ""; }
    VerticalLayout {
        spacing: 8px;
        Text {
            text: "Готовые наборы сайтов и программ. Выберите набор, затем — куда направить его трафик: получится отдельный маршрут.";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        Rectangle {
            height: min(max(App.presets.length, 1) * 66px, 440px);
            ListView {
                for p in App.presets: Rectangle {
                    height: 66px;
                    Rectangle {
                        y: 2px;
                        height: 62px;
                        border-radius: 10px;
                        background: pta.has-hover ? Theme.card-hover : Theme.card;
                        pta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { App.preset-pick(p.id); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: p.name + " · " + p.count; color: Theme.text; font-size: 13.5px; font-weight: 600; overflow: elide; }
                                Text { text: p.desc; color: Theme.dim; font-size: 11.5px; overflow: elide; }
                                Text { text: "Рекомендуем: " + p.hint; color: Theme.faint; font-size: 11px; overflow: elide; }
                            }
                            Rectangle {
                                width: 22px;
                                if p.added: Icon { name: "check"; size: 18px; color: Theme.accent; }
                            }
                        }
                    }
                }
            }
        }
    }
}
