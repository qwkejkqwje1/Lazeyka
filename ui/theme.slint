// Design tokens: one dark theme, one accent.
export global Theme {
    out property <color> bg: #0d0f13;
    out property <color> panel: #13161c;
    out property <color> card: #191d25;
    out property <color> card-hover: #20252f;
    out property <color> card-press: #262c38;
    out property <color> line: #262b35;
    out property <color> text: #eceff4;
    out property <color> dim: #9aa3b3;
    out property <color> faint: #677083;
    out property <color> accent: #2fe0a3;
    out property <color> accent-dim: #1fae7e;
    out property <color> on-accent: #062018;
    out property <color> warn: #ffb648;
    out property <color> err: #ff6b6b;
    out property <color> idle: #5b6476;
    out property <color> link: #7fb2ff;

    out property <length> radius: 14px;
    out property <length> radius-small: 10px;
    out property <length> font-small: 12px;
    out property <length> font: 14px;
    out property <length> font-title: 20px;
    out property <length> font-big: 24px;
    out property <string> font-family: "Segoe UI";
}
