import { Theme } from "theme.slint";
import { Icon, Logo } from "icons.slint";
import { App, ServerItem, SourceItem, SubItem, CountryItem, RouteItem, TargetItem } from "state.slint";
import { HomePage } from "home.slint";
import { ServersPage } from "servers.slint";
import { RoutesPage } from "routes.slint";
import { SettingsPage } from "settings.slint";
import { AddDialog, ServerDialog, AppsDialog, SourcesDialog, SubsDialog, LogDialog, AboutDialog, UninstallDialog, SortDialog, CountriesDialog, LocationDialog, TargetKindsDialog, TargetCountryDialog, TargetServerDialog, TargetChainDialog, ChainsDialog, ChainEditDialog, HopKindsDialog, HopCountryDialog, HopServerDialog, ListsDialog, ListEditDialog, ListNameDialog, ListDeleteDialog, RouteNameDialog, RouteDeleteDialog, PresetsDialog } from "dialogs.slint";

export { App, ServerItem, SourceItem, SubItem, CountryItem, RouteItem, TargetItem }

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        Rectangle {
            height: 28px;
            Rectangle {
                width: 46px;
                height: 28px;
                border-radius: 14px;
                background: root.active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.card-hover : transparent;
                animate background { duration: 150ms; }
                Icon {
                    name: root.icon;
                    size: 19px;
                    color: root.active ? Theme.accent : Theme.dim;
                }
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.dim;
            font-size: 11px;
            font-weight: root.active ? 600 : 400;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Лазейка";
    in property <image> app-icon;
    icon: app-icon;
    preferred-width: 400px;
    preferred-height: 700px;
    min-width: 360px;
    min-height: 580px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font;

    function go(p: int) {
        App.page = p;
        App.page-changed(p);
    }

    // Invisible full-window layer. Flipping App.repaint marks the whole window dirty, so the next
    // frame is rendered and presented completely: Windows can drop the window's pixels (restore
    // from minimized, unlock, display changes) while the renderer would only redraw what changed.
    Rectangle {
        width: 100%;
        height: 100%;
        background: App.repaint ? #00000000 : #ffffff00;
    }

    VerticalLayout {
        // header
        HorizontalLayout {
            height: 56px;
            padding-left: 18px;
            padding-right: 12px;
            spacing: 10px;
            Logo {
                y: (parent.height - self.height) / 2;
                size: 26px;
                tint: App.state == 2 ? Theme.accent : Theme.dim;
            }
            Text {
                text: "Лазейка";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 26px;
                width: pill.preferred-width + 33px;
                border-radius: 13px;
                background: App.state == 2 ? Theme.accent.with-alpha(0.12) : Theme.card;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: App.state == 2 ? Theme.accent : App.state == 1 ? Theme.warn : App.state == 3 ? Theme.err : Theme.idle;
                    }
                    pill := Text {
                        text: App.state == 2 ? "VPN включён" : App.state == 1 ? "Подключение" : App.state == 3 ? "Ошибка" : "VPN выключен";
                        color: App.state == 2 ? Theme.accent : Theme.dim;
                        font-size: 11.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // pages
        Rectangle {
            vertical-stretch: 1;
            if App.page == 0: HomePage { }
            if App.page == 1: ServersPage { }
            if App.page == 2: RoutesPage { }
            if App.page == 3: SettingsPage { }
        }
        // bottom navigation
        Rectangle {
            height: 64px;
            background: Theme.panel;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                NavItem { icon: "power"; label: "Главная"; active: App.page == 0; clicked => { root.go(0); } }
                NavItem { icon: "globe"; label: "Серверы"; active: App.page == 1; clicked => { root.go(1); } }
                NavItem { icon: "split"; label: "Маршруты"; active: App.page == 2; clicked => { root.go(2); } }
                NavItem { icon: "sliders"; label: "Настройки"; active: App.page == 3; clicked => { root.go(3); } }
            }
        }
    }

    // dialogs on top
    if App.dialog == "add": AddDialog { }
    if App.dialog == "server": ServerDialog { }
    if App.dialog == "apps": AppsDialog { }
    if App.dialog == "sources": SourcesDialog { }
    if App.dialog == "subs": SubsDialog { }
    if App.dialog == "log": LogDialog { }
    if App.dialog == "about": AboutDialog { }
    if App.dialog == "uninstall": UninstallDialog { }
    if App.dialog == "sort": SortDialog { }
    if App.dialog == "countries": CountriesDialog { }
    if App.dialog == "location": LocationDialog { }
    if App.dialog == "target" && App.target-step == 0: TargetKindsDialog { }
    if App.dialog == "target" && App.target-step == 1: TargetCountryDialog { }
    if App.dialog == "target" && App.target-step == 2: TargetServerDialog { }
    if App.dialog == "target" && App.target-step == 3: TargetChainDialog { }
    if App.dialog == "chains": ChainsDialog { }
    if App.dialog == "chain-edit": ChainEditDialog { }
    if App.dialog == "hop" && App.hop-step == 0: HopKindsDialog { }
    if App.dialog == "hop" && App.hop-step == 1: HopCountryDialog { }
    if App.dialog == "hop" && App.hop-step == 2: HopServerDialog { }
    if App.dialog == "lists": ListsDialog { }
    if App.dialog == "list-edit": ListEditDialog { }
    if App.dialog == "list-name": ListNameDialog { }
    if App.dialog == "list-delete": ListDeleteDialog { }
    if App.dialog == "presets": PresetsDialog { }
    if App.dialog == "route-name": RouteNameDialog { }
    if App.dialog == "route-delete": RouteDeleteDialog { }

    // toast
    if App.toast != "": Rectangle {
        x: 16px;
        width: root.width - 32px;
        // at the top and without a touch area: it must never cover or swallow the
        // buttons of a dialog underneath (clicks pass through to them)
        y: 12px;
        height: tt.preferred-height + 20px;
        border-radius: 12px;
        background: #2a303c;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        tt := Text {
            x: 14px;
            width: parent.width - 28px;
            text: App.toast;
            color: Theme.text;
            font-size: 12.5px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    Timer {
        interval: 3500ms;
        running: App.toast != "";
        triggered => { App.toast = ""; }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <bool> connected;
    in property <bool> busy;
    in property <image> icon-off;
    in property <image> icon-on;
    in property <image> icon-busy;
    in property <string> tip: "Лазейка";
    icon: busy ? icon-busy : connected ? icon-on : icon-off;
    tooltip: tip;
    title: "Лазейка";
    callback show-window();
    callback toggle();
    callback quit();
    clicked => { root.show-window(); }
    Menu {
        MenuItem {
            title: "Открыть Лазейку";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.connected || root.busy ? "Отключить VPN" : "Подключить VPN";
            activated => { root.toggle(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Выход";
            activated => { root.quit(); }
        }
    }
}
